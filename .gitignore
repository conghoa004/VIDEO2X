# ==========================================
# Video2X Web Studio .gitignore
# ==========================================

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Video2X Runtime Directories & Media Cache
uploads/
output/
outputs/
temp/
tmp/
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.flv
*.ts
!app/views/static/**

# Cloudflare Tunnel binaries (downloaded by run.py)
cloudflared
cloudflared.exe
cloudflared-*

# Jupyter / IPython checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Logs & Debug
*.log
logs/

# IDE, Editor & OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
